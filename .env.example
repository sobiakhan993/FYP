# Application Environment Configuration
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501

# Storage and Database
DATABASE_URL=sqlite:///./data/quarantine.db
MODEL_REGISTRY_DIR=./models/registry
TRUSTED_HOLDOUT_PATH=./data/processed/trusted_validation.csv

# Poisoning Defense Parameters
DEFENSE_COMBINER_POLICY=weighted_score
QUARANTINE_SCORE_THRESHOLD=0.50
REGRESSION_TOLERANCE_PCT=0.03

# Logging
LOG_LEVEL=INFO
